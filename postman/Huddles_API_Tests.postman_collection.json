        {
            "name": "05. Create Huddle - Valid Request",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test(\"Status code is 201\", function () {",
                            "    pm.response.to.have.status(201);",
                            "});",
                            "",
                            "pm.test(\"Huddle created successfully\", function () {",
                            "    var jsonData = pm.response.json();",
                            "    pm.expect(jsonData.status).to.eql(\"success\");",
                            "    pm.expect(jsonData.data).to.have.property('huddle_id');",
                            "    pm.expect(jsonData.data).to.have.property('host_id');",
                            "    pm.expect(jsonData.data).to.have.property('channel_id');",
                            "    pm.expect(jsonData.data).to.have.property('status');",
                            "    pm.expect(jsonData.data).to.have.property('participants');",
                            "    pm.environment.set(\"huddle_id\", jsonData.data.huddle_id);",
                            "});",
                            "",
                            "pm.test(\"Huddle has correct status\", function () {",
                            "    var jsonData = pm.response.json();",
                            "    pm.expect(jsonData.data.status).to.eql(\"active\");",
                            "});",
                            "",
                            "pm.test(\"Participants array exists\", function () {",
                            "    var jsonData = pm.response.json();",
                            "    pm.expect(jsonData.data.participants).to.be.an('array');",
                            "    pm.expect(jsonData.data.participants.length).to.be.at.least(1);",
                            "});"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{access_token}}"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"channel_id\": \"{{channel_id}}\",\n  \"participant_ids\": []\n}"
                },
                "url": {
                    "raw": "{{base_url}}/huddles/create",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "huddles",
                        "create"
                    ]
                },
                "description": "Create a huddle with only the host"
            },
            "response": []
