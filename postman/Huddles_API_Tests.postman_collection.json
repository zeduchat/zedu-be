        {
            "name": "15. Join Huddle - Success",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test(\"Status code is 200\", function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "",
                            "pm.test(\"Successfully joined huddle\", function () {",
                            "    var jsonData = pm.response.json();",
                            "    pm.expect(jsonData.status).to.eql(\"success\");",
                            "    pm.expect(jsonData.message).to.include(\"joined huddle\");",
                            "});",
                            "",
                            "pm.test(\"Response contains required fields\", function () {",
                            "    var jsonData = pm.response.json();",
                            "    pm.expect(jsonData.data).to.have.property('huddle_id');",
                            "    pm.expect(jsonData.data).to.have.property('channel_id');",
                            "    pm.expect(jsonData.data).to.have.property('user_id');",
                            "    pm.expect(jsonData.data).to.have.property('status');",
                            "    pm.expect(jsonData.data).to.have.property('joined_at');",
                            "    pm.expect(jsonData.data).to.have.property('participant_ids');",
                            "});",
                            "",
                            "pm.test(\"Huddle ID matches\", function () {",
                            "    var jsonData = pm.response.json();",
                            "    pm.expect(jsonData.data.huddle_id).to.eql(pm.environment.get('huddle_id'));",
                            "});",
                            "",
                            "pm.test(\"User ID matches second user\", function () {",
                            "    var jsonData = pm.response.json();",
                            "    pm.expect(jsonData.data.user_id).to.eql(pm.environment.get('user_id2'));",
                            "});",
                            "",
                            "pm.test(\"Participants array includes both users\", function () {",
                            "    var jsonData = pm.response.json();",
                            "    pm.expect(jsonData.data.participant_ids).to.be.an('array');",
                            "    pm.expect(jsonData.data.participant_ids.length).to.be.at.least(2);",
                            "    pm.expect(jsonData.data.participant_ids).to.include(pm.environment.get('user_id'));",
                            "    pm.expect(jsonData.data.participant_ids).to.include(pm.environment.get('user_id2'));",
                            "    console.log(\"Updated participants:\", jsonData.data.participant_ids);",
                            "});",
                            "",
                            "pm.test(\"Huddle status is active\", function () {",
                            "    var jsonData = pm.response.json();",
                            "    pm.expect(jsonData.data.status).to.eql('active');",
                            "});"
                        ],
                        "type": "text/javascript"
                    }
